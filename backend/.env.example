# Copy to .env and fill in real values later.
# Left blank / placeholder, the app falls back to templated explanations
# instead of calling Azure OpenAI - the POC runs fine without these set.

AZURE_OPENAI_ENDPOINT=https://REPLACE_ME.openai.azure.com/
AZURE_OPENAI_API_KEY=REPLACE_ME
AZURE_OPENAI_DEPLOYMENT=REPLACE_ME
AZURE_OPENAI_API_VERSION=2024-02-15-preview

CORS_ORIGINS=http://localhost:5173
